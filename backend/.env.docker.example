APP_NAME=ScanMySocial
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.scanmysocial.com
ASSET_URL=https://app.scanmysocial.com
HTTP_PORT=127.0.0.1:8080
APP_TAG=latest
TRUSTED_PROXIES=*
APP_REVIEW_MODE=false
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_CHANNEL=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=scanmysocial
DB_USERNAME=scanmysocial
DB_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.scanmysocial.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=public
UPLOAD_DISK=r2
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_DRIVER=redis
CACHE_PREFIX=scanmysocial_cache

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_USERNAME=
REDIS_PASSWORD=change-this-redis-password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

HORIZON_PREFIX=scanmysocial_horizon:
HORIZON_DOMAIN=
HORIZON_PATH=horizon

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scanmysocial
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.scanmysocial.com
R2_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_SCHEME=null
RESEND_KEY=
RESEND_API_KEY=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
