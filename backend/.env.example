APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_REVIEW_MODE=false

# Super admin seeding
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=390

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=390
HORIZON_NAME="${APP_NAME}"
HORIZON_PATH=horizon

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=
# Optional legacy alias used in some environments
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.example.com
R2_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# AI / LLM providers
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter/google/gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
APIFY_TOKEN=
ELEVENLABS_API_KEY=
TRANSCRIPTION_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Meta / Instagram (AutoDM)
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI="${APP_URL}/social-integrations/instagram/callback"
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Local dev tip: set false if your local PHP/cURL does not trust system CA bundle yet
META_VERIFY_SSL=
AUTODM_DAILY_RECIPIENT_LIMIT_ENABLED=true
AUTODM_DEEPLINK_BASE_URL=https://scanmysocial.com
AUTODM_DEEPLINK_TTL_HOURS=

# Razorpay billing plans
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_FREE_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_PRO_YEARLY_PLAN_ID=
RAZORPAY_CREATOR_PLAN_ID=
RAZORPAY_CREATOR_YEARLY_PLAN_ID=
RAZORPAY_OFFER_MONTHLY_ID=
RAZORPAY_OFFER_YEARLY_ID=
VITE_RAZORPAY_KEY_ID="${RAZORPAY_KEY_ID}"

# Optional Slack logging
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_CHANNEL=

# Realtime notifications (optional)
# Set BROADCAST_CONNECTION=pusher when enabling websocket broadcasting.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_NOTIFICATIONS_POLL_SECONDS=20

# Researched fresh scripts
OPENAI_MODEL_SCRIPT_RESEARCH=gpt-5.4-mini
SCRIPT_RESEARCH_VERSION=1
SCRIPT_RESEARCH_DEEP_ENABLED=false
SCRIPT_REWRITE_THRESHOLD=8
SCRIPT_RESEARCH_RETENTION_DAYS=90
SCRIPT_RESEARCH_LOCK_TTL_SECONDS=120
SCRIPT_RESEARCH_LOCK_RETRY_SECONDS=10
SCRIPT_RESEARCH_LOCK_MAX_ATTEMPTS=3
SCRIPT_RESEARCH_MAX_SUPPLEMENTAL_QUERIES=1
SCRIPT_RESEARCH_MAX_SUPPLEMENTAL_SOURCES=5
